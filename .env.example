# =====================================================================
#  HospitalFlow AI  -  environment settings
#  Copy this file to ".env"  ->  cp .env.example .env
# =====================================================================

# ---- DATABASE -------------------------------------------------------
# sqlite  = zero setup, a single file at data/hospital.db  (RECOMMENDED)
# mysql   = use a real MySQL server (fill the MYSQL_* values below)
DB_TYPE=sqlite

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=hospital_bi

# ---- BACKEND --------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# ---- AI CHATBOT -----------------------------------------------------
# builtin = offline rule+SQL engine, needs nothing, always works (DEFAULT)
# ollama  = local Ollama server (ollama run llama3)
# openai  = OpenAI API (needs OPENAI_API_KEY)
LLM_PROVIDER=builtin

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- DEMO LOGIN -----------------------------------------------------
# Sign-in accounts for the dashboard. These are demo credentials - change
# them here and they change on the login screen too.
ADMIN_PASSWORD=admin123
DOCTOR_PASSWORD=doctor123
STAFF_PASSWORD=staff123

# Used to sign session tokens, and how long a session lasts.
AUTH_SECRET=hospitalflow-demo-secret-change-me
TOKEN_HOURS=12
